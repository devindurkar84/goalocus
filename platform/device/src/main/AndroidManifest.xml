<?xml version="1.0" encoding="utf-8"?>
<!-- Permissions owned by the device capabilities. They merge into the app manifest. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Session reminders and the focus Live Update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live Updates (Now Bar on One UI). Install-time permission. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The 7:30 AM session and the midnight bedtime lock must fire on time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Focus modes: an AutomaticZenRule with grayscale during sessions. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Optional NFC tag at the study desk to start a session. -->
    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

</manifest>
